<Project Sdk="Microsoft.NET.Sdk">

  <!--
    纯 BCL 逻辑测试：不引用 StarPie SDK、不使用任何 NuGet 测试框架（保持零依赖红线）。
    直接链接插件里与宿主无关的两个源文件编译。在仓库根目录运行：
      cd tests/StarPie.Plugin.PromptPaste.Tests; dotnet run -c Release
    退出码 0 = 全部通过。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>StarPie.Plugin.PromptPaste.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\StarPie.Plugin.PromptPaste\TemplateRenderer.cs" Link="Linked\TemplateRenderer.cs" />
    <Compile Include="..\..\src\StarPie.Plugin.PromptPaste\ParameterRules.cs" Link="Linked\ParameterRules.cs" />
  </ItemGroup>

</Project>
